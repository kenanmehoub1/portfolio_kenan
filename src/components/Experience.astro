---
import Section from "./Section.astro";
---

<Section text="Work Experience" href="experience">
  <!-- Technical Skills -->
  <div class="reveal mb-10">
    <h3 class="mb-4 font-serif text-2xl font-semibold text-primary">
      Technical Skills
    </h3>

    <ul class="list-none space-y-3">
      <li class="group relative flex items-start gap-3 rounded-xl border border-neutral/10 bg-surface p-4 transition-all duration-300 hover:border-primary/30 hover:bg-primary/5">
        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs text-primary">✓</span>
        <span class="text-base text-neutral">
          <span class="font-semibold text-black">Frontend :</span>
          HTML · CSS · JavaScript · Alpine.js · Livewire · React / Next.js (Basic) · Bootstrap · Tailwind CSS
        </span>
      </li>
      <li class="group relative flex items-start gap-3 rounded-xl border border-neutral/10 bg-surface p-4 transition-all duration-300 hover:border-primary/30 hover:bg-primary/5">
        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs text-primary">✓</span>
        <span class="text-base text-neutral">
          <span class="font-semibold text-black">Backend :</span>
          PHP · Laravel · Filament · Laravel Sanctum · RESTful APIs
        </span>
      </li>
      <li class="group relative flex items-start gap-3 rounded-xl border border-neutral/10 bg-surface p-4 transition-all duration-300 hover:border-primary/30 hover:bg-primary/5">
        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs text-primary">✓</span>
        <span class="text-base text-neutral">
          <span class="font-semibold text-black">Database & Tools :</span>
          MySQL · SQL · ERD Design · Postman · Git & GitHub · Supabase · Hostinger · Vercel
        </span>
      </li>
    </ul>
  </div>

  <!-- Mad Solution -->
  <div class="reveal mb-10 rounded-2xl border border-neutral/10 bg-white p-6 transition-all duration-300 hover:border-primary/20 hover:shadow-lg hover:shadow-primary/5">
    <div class="mb-4 flex flex-col items-start">
      <h3 class="mb-1 font-serif text-2xl font-semibold text-black">
        Mad Solution
      </h3>
      <h4 class="mb-0.5 font-serif text-lg font-medium text-primary">
        Laravel Developer Intern
      </h4>
      <span class="rounded-full bg-primary/10 px-3 py-0.5 text-xs font-medium text-primary">
        2023
      </span>
    </div>
    <ul class="space-y-2.5">
      <li class="flex items-start gap-3 text-base text-neutral">
        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>
        Completed a training program focused on authentication systems using Laravel.
      </li>
      <li class="flex items-start gap-3 text-base text-neutral">
        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>
        Built secure authentication flows with Laravel Sanctum (token-based API auth).
      </li>
      <li class="flex items-start gap-3 text-base text-neutral">
        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>
        Implemented registration, login, logout, and protected API routes.
      </li>
      <li class="flex items-start gap-3 text-base text-neutral">
        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>
        Gained hands-on experience with middleware, guards, and role-based access control.
      </li>
    </ul>
  </div>

  <!-- Zenfine for Property Care -->
  <div class="reveal mb-10 rounded-2xl border border-neutral/10 bg-white p-6 transition-all duration-300 hover:border-primary/20 hover:shadow-lg hover:shadow-primary/5">
    <div class="mb-4 flex flex-col items-start">
      <h3 class="mb-1 font-serif text-2xl font-semibold text-black">
        Zenfine for Property Care
      </h3>
      <h4 class="mb-0.5 font-serif text-lg font-medium text-primary">
        Full-Stack Developer (Remote)
      </h4>
      <span class="rounded-full bg-primary/10 px-3 py-0.5 text-xs font-medium text-primary">
        2024
      </span>
    </div>
    <ul class="space-y-2.5">
      <li class="flex items-start gap-3 text-base text-neutral">
        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>
        Developed and maintained the company website for a UAE-based cleaning services business.
      </li>
      <li class="flex items-start gap-3 text-base text-neutral">
        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>
        Built a full invoice management system and task tracking dashboard.
      </li>
    </ul>
  </div>

  <!-- Freelance Project -->
  <div class="reveal mb-10 rounded-2xl border border-neutral/10 bg-white p-6 transition-all duration-300 hover:border-primary/20 hover:shadow-lg hover:shadow-primary/5">
    <div class="mb-4 flex flex-col items-start">
      <h3 class="mb-1 font-serif text-2xl font-semibold text-black">
        Freelance Project
      </h3>
      <h4 class="mb-0.5 font-serif text-lg font-medium text-primary">
        Full-Stack Developer
      </h4>
      <span class="rounded-full bg-primary/10 px-3 py-0.5 text-xs font-medium text-primary">
        2026
      </span>
    </div>
    <ul class="space-y-2.5">
      <li class="flex items-start gap-3 text-base text-neutral">
        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>
        Designed and developed a real estate platform from scratch.
      </li>
      <li class="flex items-start gap-3 text-base text-neutral">
        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>
        Built a powerful admin dashboard using Filament for full content control.
      </li>
      <li class="flex items-start gap-3 text-base text-neutral">
        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>
        Implemented property listings, filtering, and management features.
      </li>
      <li class="flex items-start gap-3 text-base text-neutral">
        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>
        Collaborated with a React & Next.js front-end team for 4 months.
      </li>
    </ul>
  </div>
</Section>

<script>
  // تأثير الظهور عند التمرير
  const revealElements = document.querySelectorAll('.reveal');
  
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
  );

  revealElements.forEach((el) => revealObserver.observe(el));
</script>