---
const currentYear = new Date().getFullYear();

const socials = [
  { name: "Facebook", url: "https://www.facebook.com/share/1K3sWENu8a/" },
  { name: "Telegram", url: "https://t.me/kenan_mehoub" },
  { name: "WhatsApp", url: "https://wa.me/963998187380" },
  { name: "Instagram", url: "https://www.instagram.com/kenan_mehoub" },
  { name: "GitHub", url: "https://github.com/kenanmehoub1" },
];
---

<footer
  class="w-full border-t border-neutral/10 bg-surface px-5 pt-10 pb-8 text-center text-black"
>
  <div class="mx-auto max-w-3xl">
    <ul class="mb-6 flex flex-wrap justify-center gap-2 text-sm">
      {
        socials.map((social) => (
          <li>
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block rounded-full px-5 py-2.5 font-medium text-neutral transition-all duration-300 hover:bg-primary/10 hover:text-primary"
            >
              {social.name}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="text-xs text-neutral">
      <span class="text-neutral-light">Designed & Developed by</span>
      <span class="font-medium text-black"> Kenan Mehoub</span>
    </p>
    <p class="mt-2 text-xs text-neutral-light">© {currentYear} — All rights reserved</p>
  </div>
</footer>