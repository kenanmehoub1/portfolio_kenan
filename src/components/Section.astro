---
interface Props {
  text: string;
  href: string;
}

const { text, href } = Astro.props;
---

<section id={href} class="py-24">
  <div class="reveal mb-14 flex items-center gap-4">
    <span class="h-px w-8 bg-primary"></span>
    <h2
      class="font-serif text-4xl font-bold tracking-tighter text-black md:text-5xl"
    >
      {text}
    </h2>
  </div>
  <slot />
</section>