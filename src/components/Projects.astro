---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Featured Projects" href="projects">
  <div style="top: 98px;" class="sticky mb-12 rounded-2xl border border-neutral/20 bg-black">
    <div class="bg-difu relative z-1 grid h-145 w-full grid-rows-2 rounded-2xl bg-[#1c232d]/85 before:absolute before:inset-0 before:z-[-1] before:rounded-2xl before:bg-[url(/raja.png)] before:bg-size-[128px] before:bg-repeat before:opacity-5 before:content-[''] sm:grid-cols-2 sm:grid-rows-1 md:h-96">
      <div class="px-6 pt-12">
        <h3 class="mb-5 font-serif text-3xl font-medium text-primary">
          Zenfine for Property Care
        </h3>
        <p class="text-base text-neutral">
          A complete website for a UAE-based cleaning services company,
          featuring a full invoice management system and task tracking
          dashboard to streamline daily operations and client management.
        </p>
        <p class="mt-4 text-base text-neutral">
          <span class="font-medium text-white">Technologies :</span>
          PHP · Laravel · Blade
        </p>
        <div class="flex gap-5 pt-10 text-white">
          <a
            href="https://zenfine1.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="after:relative after:-bottom-1.25 after:content-[url(/external.svg)] hover:underline"
          >
            Preview
          </a>
        </div>
      </div>
      <div class="flex items-end justify-end overflow-hidden">
        <Image
          class="h-full w-[95%] rounded-ss-xl rounded-ee-2xl object-none object-top-left sm:h-[85%] sm:w-full"
          src={projects[0].image}
          alt="Zenfine for Property Care"
          width="736"
          height="483"
        />
      </div>
    </div>
  </div>

  <div style="top: 138px;" class="sticky mb-12 rounded-2xl border border-neutral/20 bg-black">
    <div class="bg-difu relative z-1 grid h-145 w-full grid-rows-2 rounded-2xl bg-[#1c232d]/85 before:absolute before:inset-0 before:z-[-1] before:rounded-2xl before:bg-[url(/raja.png)] before:bg-size-[128px] before:bg-repeat before:opacity-5 before:content-[''] sm:grid-cols-2 sm:grid-rows-1 md:h-96">
      <div class="px-6 pt-12">
        <h3 class="mb-5 font-serif text-3xl font-medium text-primary">
          Real Estate Platform
        </h3>
        <p class="text-base text-neutral">
          A full real estate platform with property listings, advanced
          filtering, and a powerful custom admin dashboard for complete
          content and property management.
        </p>
        <p class="mt-4 text-base text-neutral">
          <span class="font-medium text-white">Technologies :</span>
          PHP · Laravel · Blade · Filament
        </p>
        <div class="flex gap-5 pt-10 text-white">
          <a
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="after:relative after:-bottom-1.25 after:content-[url(/external.svg)] hover:underline"
          >
            Preview
          </a>
        </div>
      </div>
      <div class="flex items-end justify-end overflow-hidden">
        <Image
          class="h-full w-[95%] rounded-ss-xl rounded-ee-2xl object-none object-top-left sm:h-[85%] sm:w-full"
          src={projects[1].image}
          alt="Real Estate Platform"
          width="736"
          height="483"
        />
      </div>
    </div>
  </div>
</Section>